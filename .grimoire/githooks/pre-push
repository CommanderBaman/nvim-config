#!/bin/sh

echo "🧪 Running prepush checks"
task check:prepush
status=$?

# check if command successful
if [ $status -ne 0 ]; then
    echo "❌ Prepush checks Failed"
    echo "Local changes affect the check process. If you have any local changes, stash them and run the push command again."
    exit $status
else
    echo "✅ Task done"
fi

echo "Pushing"
